@model PagedList<ProductViewModel>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1>Products</h1><a class="btn btn-primary" asp-action="Create">Add New Product</a></div>
<partial name="_ListFilters" model="Model.Query" />
@if (!Model.Items.Any()) { <p class="alert alert-info">No products found. Adjust the filters or add a product.</p> }
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <caption class="visually-hidden">Products</caption><thead><tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col">Price</th><th scope="col">Stock</th><th scope="col">Unit</th><th scope="col">Available</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var item in Model.Items)
        {
            <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Price.ToString("N2")</td><td>@item.StockQuantity</td><td>@item.Unit</td><td>@(item.IsAvailable ? "Yes" : "No")</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.Name">Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="ms-2 text-danger" aria-label="Delete @item.Name">Delete</a></td></tr>
        }</tbody>
    </table></div>
}
<partial name="_Pagination" model="Model" />
