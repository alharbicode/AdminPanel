@model PagedList<CategoryViewModel>
@{ ViewData["Title"] = "Categories"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1>Categories</h1><a class="btn btn-primary" asp-action="Create">Add New Category</a></div>
<partial name="_ListFilters" model="Model.Query" />
@if (!Model.Items.Any()) { <p class="alert alert-info">No categories found. Adjust the filters or add a category.</p> }
else
{
    <div class="table-responsive" role="region" aria-label="Scrollable records" tabindex="0"><table class="table table-striped align-middle">
        <caption class="visually-hidden">Categories</caption><thead><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var item in Model.Items)
        {
            <tr><td>@item.Name</td><td>@item.Description</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.Name">Edit</a> <a asp-action="Delete" asp-route-id="@item.Id" class="ms-2 text-danger" aria-label="Delete @item.Name">Delete</a></td></tr>
        }</tbody>
    </table></div>
}
<partial name="_Pagination" model="Model" />
