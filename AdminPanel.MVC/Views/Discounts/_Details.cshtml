@model DiscountViewModel
<dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
<dt class="col-sm-3">Product</dt><dd class="col-sm-9">@Model.ProductName</dd>
<dt class="col-sm-3">Percentage</dt><dd class="col-sm-9">@(Model.Percentage.ToString("0.##"))%</dd>
<dt class="col-sm-3">Start date (UTC)</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd HH:mm:ss")</dd>
<dt class="col-sm-3">End date (UTC)</dt><dd class="col-sm-9">@Model.EndDate.ToString("yyyy-MM-dd HH:mm:ss")</dd></dl>
