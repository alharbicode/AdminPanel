@model PagedList<OrderViewModel>
@{ ViewData["Title"] = "Orders"; }
<h1>Orders</h1>
@if (TempData["Message"] is string message) { <div class="alert alert-info" role="status">@message</div> }
<partial name="_ListFilters" model="Model.Query" />
@if (!Model.Items.Any()) { <p class="alert alert-info">No orders found. Adjust the filters.</p> }
else
{
    <div class="table-responsive" role="region" aria-label="Scrollable records" tabindex="0"><table class="table table-striped align-middle">
        <caption>Stored order amounts; currency is not configured. Dates are UTC.</caption>
        <thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Status</th><th scope="col">Date (UTC)</th><th scope="col">Total</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var order in Model.Items)
        {
            <tr><td>@order.Id</td><td>@order.CustomerName</td><td>@order.Status</td><td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td><td>@order.TotalPrice.ToString("N2")</td><td><a asp-action="Details" asp-route-id="@order.Id" aria-label="Details for order @order.Id">Details</a></td></tr>
        }</tbody>
    </table></div>
}
<partial name="_Pagination" model="Model" />
