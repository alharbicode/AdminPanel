@model AdminPanel.MVC.Models.OrderViewModel
@{ ViewData["Title"] = $"Order #{Model.Id}"; }
<h1>Order #@Model.Id</h1>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-info" role="status">@message</div>
}
<div class="card mb-3">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.Reference)) { <p><strong>Reference:</strong> @Model.Reference</p> }
        <p><strong>Customer:</strong> @Model.CustomerName @(Model.IsGuest ? "(guest checkout)" : "")</p>
        @if (!string.IsNullOrEmpty(Model.CustomerEmail)) { <p><strong>Email:</strong> @Model.CustomerEmail</p> }
        @if (!string.IsNullOrEmpty(Model.Phone)) { <p><strong>Phone:</strong> <span dir="ltr">@Model.Phone</span></p> }
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Date (UTC):</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
        @if (!string.IsNullOrEmpty(Model.PaymentMethod)) { <p><strong>Payment:</strong> @(Model.PaymentMethod == "COD" ? "Cash on Delivery (COD)" : Model.PaymentMethod)</p> }
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.AddressLine))
{
    <section class="card mb-3" aria-labelledby="delivery-title">
        <div class="card-body">
            <h2 class="h4" id="delivery-title">Delivery snapshot</h2>
            <p>@(Model.CountryCode == "YE" ? "Yemen" : Model.CountryCode) / @Model.Governorate / @Model.City</p>
            <p class="text-break">@Model.AddressLine</p>
            @if (!string.IsNullOrEmpty(Model.DeliveryInstructions)) { <p class="text-break"><strong>Instructions:</strong> @Model.DeliveryInstructions</p> }
        </div>
    </section>
}
@if (Model.CancellationRequestedAt.HasValue)
{
    <div class="alert alert-warning">
        <h2 class="h5">Customer cancellation request</h2>
        <p>@Model.CancellationRequestedAt.Value.ToString("yyyy-MM-dd HH:mm") UTC — @Model.CancellationRequestReason</p>
        <p>A request does not cancel the order. Review its current status before taking action. Shipped and delivered orders cannot restore inventory through cancellation.</p>
    </div>
}
@if (Model.CancelledAt.HasValue)
{
    <div class="alert alert-info">
        <h2 class="h5">Cancellation record</h2>
        <p><strong>Actor:</strong> @Model.CancelledBy</p>
        <p><strong>Cancelled (UTC):</strong> @Model.CancelledAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Reason:</strong> @Model.CancellationReason</p>
        @if (Model.StockRestoredAt.HasValue) { <p><strong>Stock restored (UTC):</strong> @Model.StockRestoredAt.Value.ToString("yyyy-MM-dd HH:mm")</p> }
    </div>
}
<h2 class="h4">Items</h2>
<div class="table-responsive" role="region" aria-label="Scrollable records" tabindex="0"><table class="table table-bordered">
    <caption>Stored item prices and discounts. @(Model.Currency ?? "Legacy currency unspecified").</caption>
    <thead><tr><th scope="col">Product</th><th scope="col" class="text-end">Original unit price</th><th scope="col" class="text-end">Unit discount</th><th scope="col" class="text-end">Price</th><th scope="col" class="text-end">Qty</th><th scope="col" class="text-end">Line Total</th></tr></thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName @if (!string.IsNullOrEmpty(item.DiscountName)) { <small class="d-block">@item.DiscountName (@item.DiscountPercentage%)</small> }</td>
                <td class="text-end">@(item.OriginalUnitPrice?.ToString("N2") ?? "Not recorded")</td>
                <td class="text-end">@(item.UnitDiscount?.ToString("N2") ?? "Not recorded")</td>
                <td class="text-end">@item.Price.ToString("N2")</td>
                <td class="text-end">@item.Quantity</td>
                <td class="text-end">@item.LineTotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        @if (Model.Subtotal.HasValue)
        {
            <tr><th colspan="5" class="text-end">Subtotal</th><td class="text-end">@Model.Subtotal.Value.ToString("N2")</td></tr>
            <tr><th colspan="5" class="text-end">Discounts</th><td class="text-end">−@Model.DiscountTotal?.ToString("N2")</td></tr>
            <tr><th colspan="5" class="text-end">Shipping</th><td class="text-end">@Model.ShippingFee?.ToString("N2")</td></tr>
        }
        <tr><th colspan="5" class="text-end">@(Model.PaymentMethod == "COD" ? "Total COD amount" : "Total")</th><th class="text-end">@Model.TotalToDisplay.ToString("N2") @Model.Currency</th></tr>
    </tfoot>
</table></div>
@if (!Model.Subtotal.HasValue)
{
    <p class="alert alert-secondary">This administration or legacy order has no shipping, discount, payment or currency summary snapshot. The stored total is shown without inventing historical charges.</p>
}
@if (Model.NextStatus is string nextStatus)
{
    <hr />
    <h2 class="h5">Update Status</h2>
    <form asp-action="UpdateStatus" method="post" class="row g-2 align-items-center">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="version" value="@Model.Version" />
        <div class="col-auto"><label for="newStatus" class="form-label">New status</label><select id="newStatus" name="newStatus" class="form-select"><option value="@nextStatus">@nextStatus</option></select></div>
        <div class="col-auto"><button type="submit" class="btn btn-success">Update</button></div>
    </form>
}
@if (Model.CanCancel)
{
    <hr />
    <h2 class="h5">Cancel order</h2>
    <p>Cancellation preserves the order and restores its inventory once. It is unavailable after shipping.</p>
    <form asp-action="Cancel" method="post" class="management-form mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="version" value="@Model.Version" />
        <div class="mb-3"><label for="reason" class="form-label">Cancellation reason</label><textarea id="reason" name="reason" class="form-control" required maxlength="500"></textarea></div>
        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cancel this order?');">Cancel Order</button>
    </form>
}
<a asp-action="Index" class="btn btn-secondary mt-3">Back to Orders</a>
