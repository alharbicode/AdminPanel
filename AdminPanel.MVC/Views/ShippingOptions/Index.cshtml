@model PagedList<ShippingOptionViewModel>
@{ ViewData["Title"] = "Shipping options"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1>Shipping options</h1><a asp-action="Create" class="btn btn-primary">Create shipping option</a></div>
<p>These are legacy administration shipping records. Configure storefront delivery destinations and YER rates in <a asp-controller="ShippingZones" asp-action="Index">Shipping zones</a>.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-4"><label for="Search" class="form-label">Search</label><input id="Search" name="Search" value="@Model.Query.Search" maxlength="200" class="form-control" placeholder="Name or area" /></div>
    <div class="col-md-3"><label for="Area" class="form-label">Area contains</label><input id="Area" name="Area" value="@Model.Query.Area" maxlength="200" class="form-control" /></div>
    <div class="col-md-2"><label for="PageSize" class="form-label">Per page</label><select id="PageSize" name="PageSize" class="form-select">
        @foreach (var size in new[] { 10, 25, 50, 100 }.Append(Model.Query.PageSize).Where(x => x >= 1 && x <= 100).Distinct().OrderBy(x => x))
        { <option value="@size" selected="@(Model.Query.PageSize == size)">@size</option> }
    </select></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Apply filters</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
</form>
@if (!Model.Items.Any())
{
    <div class="alert alert-info">No shipping options found. Adjust the filters or create a shipping option.</div>
}
else
{
    <div class="table-responsive" role="region" aria-label="Scrollable records" tabindex="0"><table class="table table-striped align-middle">
        <caption class="visually-hidden">Shipping options</caption><thead><tr><th scope="col">Name</th><th scope="col">Area</th><th scope="col">Price</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var item in Model.Items)
        {
            <tr><td>@item.Name</td><td>@item.Area</td><td>@item.Price.ToString("N2")</td><td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id" aria-label="Details for @item.Name">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="ms-2" aria-label="Edit @item.Name">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="ms-2 text-danger" aria-label="Delete @item.Name">Delete</a>
            </td></tr>
        }</tbody>
    </table></div>
}
<partial name="_Pagination" model="Model" />
