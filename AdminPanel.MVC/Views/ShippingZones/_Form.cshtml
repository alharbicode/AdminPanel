@model ShippingZoneViewModel
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="Version" />
<div class="mb-3"><label asp-for="Governorate" class="form-label"></label><input asp-for="Governorate" class="form-control" maxlength="100" /><span asp-validation-for="Governorate" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" maxlength="100" aria-describedby="city-help" /><span asp-validation-for="City" class="text-danger"></span><p id="city-help" class="form-text">Leave blank to allow delivery throughout this governorate at this rate. Customers select an enabled zone. Do not enable a governorate-wide zone if any cities should be excluded.</p></div>
<div class="mb-3"><label asp-for="Fee" class="form-label"></label><input asp-for="Fee" type="number" min="0" step="0.01" class="form-control" /><span asp-validation-for="Fee" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label">Enabled for checkout in Yemen</label></div>
