<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AdminPanel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">AdminPanel</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-nav flex-row gap-3">
                        <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                        <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
                        <a class="nav-link" asp-controller="Orders" asp-action="Index">Orders</a>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-outline-secondary" type="submit">Sign out @User.Identity.Name</button>
                    </form>
                }
            </div>
        </nav>
    </header>
    <div class="container"><main role="main" class="pb-3">@RenderBody()</main></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
