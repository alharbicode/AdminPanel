@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    // Visualization math only: all counts and records come from the existing dashboard endpoint.
    var availability = Model.ProductCount == 0 ? 0 : 100d * Model.AvailableProductCount / Model.ProductCount;
    var availabilityWidth = availability.ToString("0.###", CultureInfo.InvariantCulture);
    var statusTotal = Model.OrdersByStatus.Sum(status => status.Count);
    var position = 0d;
    var segments = new List<string>();
    string StatusColor(string status) => status switch
    {
        "Pending" => "#b49aff", "Confirmed" => "#78a8ff",
        "Preparing" => "#f2c078", "Shipped" => "#5dd6e1", "Delivered" => "#78dcb2", "Cancelled" => "#ec9ba9", _ => "#9faabd"
    };
    string StatusClass(string status) => status switch
    {
        "Pending" => "pending", "Confirmed" => "confirmed",
        "Shipped" => "shipped", "Delivered" => "delivered", _ => "other"
    };
    foreach (var status in Model.OrdersByStatus)
    {
        var end = position + (statusTotal == 0 ? 0 : 100d * status.Count / statusTotal);
        segments.Add($"{StatusColor(status.Status)} {position.ToString("0.###", CultureInfo.InvariantCulture)}% {end.ToString("0.###", CultureInfo.InvariantCulture)}%");
        position = end;
    }
    var distribution = statusTotal == 0 ? "#242c3c" : $"conic-gradient({string.Join(", ", segments)})";
}
<div class="dashboard-heading">
    <div><p class="eyebrow">Your workspace, at a glance</p><h1>Dashboard</h1><p class="dashboard-intro">A clearer view of your catalog, inventory, and orders.</p></div>
    <div class="dashboard-actions">
        <a class="workspace-button button-quiet" asp-controller="Dashboard" asp-action="Index"><partial name="_WorkspaceIcon" model='@("Refresh")' />Refresh</a>
        <a class="workspace-button button-accent" asp-controller="Products" asp-action="Create"><partial name="_WorkspaceIcon" model='@("Plus")' />Add product</a>
    </div>
</div>

<section class="metric-grid" aria-label="Current record counts">
    @foreach (var card in new[] {
        new { Label = "Products", Count = Model.ProductCount, Controller = "Products", Note = "In your catalog", Accent = "violet" },
        new { Label = "Orders", Count = Model.OrderCount, Controller = "Orders", Note = "Across all statuses", Accent = "cyan" },
        new { Label = "Categories", Count = Model.CategoryCount, Controller = "Categories", Note = "Organizing your catalog", Accent = "blue" } })
    {
        <a class="metric-card metric-@card.Accent" asp-controller="@card.Controller" asp-action="Index">
            <div class="metric-top"><span class="metric-label">@card.Label</span><span class="metric-icon"><partial name="_WorkspaceIcon" model="@card.Controller" /></span></div>
            <span class="metric-value">@card.Count.ToString("N0")</span>
            <span class="metric-bottom"><span>@card.Note</span><partial name="_WorkspaceIcon" model='@("ArrowUpRight")' /></span>
        </a>
    }
</section>

<section class="resource-grid" aria-label="More administration records">
    @foreach (var card in new[] {
        new { Label = "Shipping zones", Count = Model.ShippingZoneCount, Controller = "ShippingZones" },
        new { Label = "Shipping options", Count = Model.ShippingOptionCount, Controller = "ShippingOptions" },
        new { Label = "Discounts", Count = Model.DiscountCount, Controller = "Discounts" },
        new { Label = "Content pages", Count = Model.ContentPageCount, Controller = "ContentPages" } })
    {
        <a class="resource-card" asp-controller="@card.Controller" asp-action="Index"><span class="resource-icon"><partial name="_WorkspaceIcon" model="@card.Controller" /></span><span class="resource-copy"><span>@card.Label</span><strong>@card.Count.ToString("N0")</strong></span><partial name="_WorkspaceIcon" model='@("ArrowUpRight")' /></a>
    }
</section>

<div class="dashboard-panels">
    <section class="dashboard-panel inventory-panel" aria-labelledby="inventory-title">
        <div class="panel-heading"><div><p class="eyebrow">Catalog health</p><h2 id="inventory-title">Inventory overview</h2></div><span class="panel-icon"><partial name="_WorkspaceIcon" model='@("Stock")' /></span></div>
        <div class="availability-heading"><div><strong>@Model.AvailableProductCount.ToString("N0")</strong><span>available products</span></div><span class="percentage-label">@availability.ToString("0")<span>%</span></span></div>
        <div class="availability-track" aria-hidden="true"><span style="width: @(availabilityWidth)%"></span></div>
        <dl class="inventory-legend">
            <div><dt><span class="legend-dot available" aria-hidden="true"></span>Available products</dt><dd>@Model.AvailableProductCount.ToString("N0")</dd></div>
            <div><dt><span class="legend-dot unavailable" aria-hidden="true"></span>Unavailable products</dt><dd>@((Model.ProductCount - Model.AvailableProductCount).ToString("N0"))</dd></div>
        </dl>
        <div class="stock-summary"><div><span class="stock-count">@Model.OutOfStockProductCount.ToString("N0")</span><span>Products with zero stock</span></div><a asp-controller="Products" asp-action="Index" asp-route-Stock="out-of-stock">Review stock<partial name="_WorkspaceIcon" model='@("Arrow")' /></a></div>
    </section>
    <section class="dashboard-panel orders-panel" aria-labelledby="status-title">
        <div class="panel-heading"><div><p class="eyebrow">Order distribution</p><h2 id="status-title">Orders by status</h2></div><span class="panel-label">All orders</span></div>
        <div class="order-distribution">
            <div class="status-chart" style="--distribution: @distribution" aria-hidden="true"><div><strong>@Model.OrderCount.ToString("N0")</strong><span>Total orders</span></div></div>
            @if (Model.OrdersByStatus.Count == 0)
            {
                <p class="empty-chart-message">No orders yet.<span>Order statuses will appear here.</span></p>
            }
            else
            {
                <dl class="status-legend">
                    @foreach (var status in Model.OrdersByStatus)
                    {
                        <div><dt><span class="legend-dot" style="background: @StatusColor(status.Status)" aria-hidden="true"></span>@status.Status</dt><dd>@status.Count.ToString("N0")</dd></div>
                    }
                </dl>
            }
        </div>
        <a class="panel-footer-link" asp-controller="Orders" asp-action="Index">Explore orders<partial name="_WorkspaceIcon" model='@("Arrow")' /></a>
    </section>
</div>

<section class="dashboard-panel recent-orders" aria-labelledby="recent-orders-title">
    <div class="panel-heading"><div><p class="eyebrow">Latest activity</p><h2 id="recent-orders-title">Recent orders</h2></div><a class="text-action" asp-controller="Orders" asp-action="Index">View all orders<partial name="_WorkspaceIcon" model='@("Arrow")' /></a></div>
    @if (Model.RecentOrders.Count == 0)
    {
        <div class="empty-orders"><span class="empty-orders-icon"><partial name="_WorkspaceIcon" model='@("Orders")' /></span><div><h3>No orders yet.</h3><p>Your five most recent orders will appear here.</p></div></div>
    }
    else
    {
        <div class="table-responsive" role="region" aria-label="Scrollable records" tabindex="0">
            <table class="table dashboard-table">
                <caption>Five most recent orders. Totals retain their recorded currency; older records without a currency snapshot are marked unspecified.</caption>
                <thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Date (UTC)</th><th scope="col">Status</th><th scope="col">Total</th></tr></thead>
                <tbody>@foreach (var order in Model.RecentOrders)
                {
                    <tr><td><a class="order-id" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td><td><span class="customer-cell"><span class="customer-avatar" aria-hidden="true">@(string.IsNullOrEmpty(order.CustomerName) ? "?" : order.CustomerName[..1].ToUpperInvariant())</span>@order.CustomerName</span></td><td class="order-date">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td><td><span class="order-status status-@StatusClass(order.Status)"><span aria-hidden="true"></span>@order.Status</span></td><td class="order-total">@order.TotalPrice.ToString("N2") @(order.Currency ?? "(currency unspecified)")</td></tr>
                }</tbody>
            </table>
        </div>
    }
</section>
<p class="dashboard-data-note"><partial name="_WorkspaceIcon" model='@("Refresh")' />Current records from your administration system. Refresh to update.</p>
