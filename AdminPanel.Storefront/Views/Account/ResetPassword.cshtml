@model ResetModel
@{ ViewData["Title"] = T["ResetPassword"]; }
<div class="container page-content"><section class="account-panel"><h1>@T["ResetPassword"]</h1>
<p>@T["ResetHelp"]</p><form method="post" id="password-reset-form"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" dir="ltr" required /><span asp-validation-for="Email"></span></div>
<div class="form-field"><label asp-for="Token">@T["ResetCode"]</label><input asp-for="Token" type="password" autocomplete="off" maxlength="43" dir="ltr" required /><span asp-validation-for="Token"></span></div>
<div class="form-field"><label asp-for="Password">@T["NewPassword"]</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><span asp-validation-for="Password"></span></div>
<div class="form-field"><label asp-for="ConfirmPassword">@T["ConfirmPassword"]</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required /><span asp-validation-for="ConfirmPassword"></span></div>
<button class="button">@T["ResetPassword"]</button></form>
</section></div>

