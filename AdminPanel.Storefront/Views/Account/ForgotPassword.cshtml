@model ForgotModel
@{ ViewData["Title"] = T["ForgotPassword"]; }
<div class="container page-content"><section class="account-panel"><h1>@T["ForgotPassword"]</h1>
<p>@T["RecoveryHelp"]</p><form method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" dir="ltr" required /><span asp-validation-for="Email"></span></div>
<button class="button">@T["SendReset"]</button></form><p class="account-links"><a asp-action="ResetPassword">@T["HaveResetCode"]</a><a asp-action="Login">@T["Login"]</a></p>
</section></div>

