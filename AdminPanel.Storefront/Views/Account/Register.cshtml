@model RegisterModel
@{ ViewData["Title"] = T["Register"]; }
<div class="container page-content"><section class="account-panel"><h1>@T["Register"]</h1>
<form method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="DisplayName">@T["DisplayName"]</label><input asp-for="DisplayName" type="text" autocomplete="name" maxlength="100" required /><span asp-validation-for="DisplayName"></span></div>
<div class="form-field"><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" autocomplete="email" maxlength="254" dir="ltr" required /><span asp-validation-for="Email"></span></div>
<div class="form-field"><label asp-for="Password">@T["Password"]</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><span asp-validation-for="Password"></span></div>
<p class="field-help">@T["PasswordLength"]</p>
<div class="form-field"><label asp-for="ConfirmPassword">@T["ConfirmPassword"]</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required /><span asp-validation-for="ConfirmPassword"></span></div>
<button class="button">@T["CreateAccount"]</button></form><p class="account-links"><a asp-action="Login">@T["AlreadyRegistered"]</a></p>
</section></div>

