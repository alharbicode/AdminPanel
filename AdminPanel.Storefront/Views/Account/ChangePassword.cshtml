@model ChangePasswordModel
@{ ViewData["Title"] = T["ChangePassword"]; }
<div class="container page-content"><section class="account-panel"><h1>@T["ChangePassword"]</h1>
<p>@T["PasswordSessions"]</p><form method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="form-field"><label asp-for="CurrentPassword">@T["CurrentPassword"]</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" maxlength="128" required /><span asp-validation-for="CurrentPassword"></span></div>
<div class="form-field"><label asp-for="Password">@T["NewPassword"]</label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /><span asp-validation-for="Password"></span></div>
<div class="form-field"><label asp-for="ConfirmPassword">@T["ConfirmPassword"]</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" maxlength="128" required /><span asp-validation-for="ConfirmPassword"></span></div>
<button class="button">@T["ChangePassword"]</button></form>
</section></div>

